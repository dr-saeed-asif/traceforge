 \"src/infrastructure/sqlite/sqlite-migrator.ts\": \"bd5a44c9d23ab5b14fea7905eb0e1d52abf46f8a8875be8825f8daf73f723379\",\n26:     \"src/infrastructure/sqlite/sqlite-prompt-result-repository.ts\": \"4a56e6e77656aa9bf9359991b699cb9c0f65511e99e5ab0f198b10f9ffa90070\",\n27:     \"src/mcp-claim-gate.ts\": \"20c254ffb7e4dc906bb5b8c232826cc221fdf4735b0da4b55759d218e50594a8\",\n28:     \"src/migrate.ts\": \"ca4634ffcce29fb032f771417b4dd15a2cfab7f398c6574ab3d7ad702b1439c0\",\n29:     \"src/modules/verification/application/anchor-lookup.ts\": \"4318115ef9844184d2109b193f79e2af32619d236999821da153570097adbc8b\",\n30:     \"src/modules/verification/application/claim-extractor.ts\": \"2cc51568233df91e6b0ed406e8ec4fc555647173ba8ba479aa418e049eee58c8\",\n31:     \"src/modules/verification/application/claim-record.ts\": \"dce9700f131df7bb8cc82f132756495847b0a98b806175d1967d811980309cbf\",\n32:     \"src/modules/verification/application/claim-verifier.ts\": \"8d09bd6687f630eded8bf3469215dafe44b0ac07e2dcaa8021ec86eb6c3b0409\",\n33:     \"src/modules/verification/application/ollama-claim-extractor.ts\": \"7f239f88afea2394576250fe5a4ade046c4a865d5d25535eacf4908f51317851\",\n34:     \"src/modules/verification/application/ports/verification-repository.ts\": \"4a63c86790decacf3baa4d177065f03543abf40a92cd2c56942a4b3e018b019a\",\n35:     \"src/modules/verification/application/trace-event-mapper.ts\": \"aacd5e775aa798ea8132781a74dc57001d88dc7ef20ddd0b49fcca9845db8b5b\",\n36:     \"src/modules/verification/application/verification-query-service.ts\": \"d62e0d2579e958736421fea9b2891a8feb9b941750fc916d823e93facfaf5b3d\",\n37:     \"src/modules/verification/application/verification-service.ts\": \"4a0cef1991557ea006c6f007c32223a38b41ec81e94d1a97f84a9f7694210a2e\",\n38:     \"src/modules/verification/application/workspace-digest.ts\": \"1edc45ad2202107fc4ff1854f431869103f912a881be16779f0ffd511e988efd\",\n39:     \"src/modules/verification/domain/claim-types.ts\": \"2c2c0b6f4b3ad40d6cfd59767ee92f2