{"record_type":"timeline-node","type":"tool-before","timestamp":"2026-10-28T12:48:51.777Z","data":{"input":{"tool":"write","sessionID":"ses_e7d7ba936ffeOnBhTlKsfisQhw","callID":"call_00_9uhndbexwapo4houquteqjij"},"output":{"args":{"filePath":"research\\annotation\\build-adjudicated-dataset.mjs","content":"#!/usr/bin/env node\nimport { existsSync, mkdirSync, readFileSync, writeFileSync } from \"node:fs\";\nimport { basename, dirname, resolve } from \"node:path\";\nimport {\n  csvRecords,\n  parseArgs,\n  parseBoolean,\n  parseCsv,\n  parseStringList,\n  readJsonl,\n  requireIsoDate,\n  sha256,\n} from \"./lib.mjs\";\n\nconst CLAIM_TYPES = new Set([\n  \"FILE_CREATED\",\n  \"FILE_MODIFIED\",\n  \"STRUCTURE_CREATED\",\n  \"DEPENDENCY_RULE\",\n  \"COMMAND_SUCCEEDED\",\n  \"BUILD_PASSED\",\n  \"TEST_PASSED\",\n  \"TASK_COMPLETED\",\n]);\nconst VERDICTS = new Set([\"VERIFIED\", \"CONTRADICTED\", \"UNSUPPORTED\", \"UNVERIFIABLE\"]);\nconst CAPTURE_COMPLETENESS = new Set([\"COMPLETE\", \"INCOMPLETE\", \"NOT_AVAILABLE\"]);\nconst EXPECTED_RESULTS = {\n  FILE_CREATED: \"target exists after the change\",\n  FILE_MODIFIED: \"target changed to the claimed implementation\",\n  STRUCTURE_CREATED: \"claimed structure exists\",\n  DEPENDENCY_RULE: \"dependency rule passes without forbidden imports\",\n  COMMAND_SUCCEEDED: \"matching command exits with code 0\",\n  BUILD_PASSED: \"exitCode equals 0\",\n  TEST_PASSED: \"exitCode equals 0 and failed equals 0\",\n  TASK_COMPLETED: \"all required objective claims are verified\",\n};\nconst REQUIRED_COLUMNS = [\n  \"session_id\",\n  \"claim_id\",\n  \"source_quote\",\n  \"claim_type\",\n  \"target\",\n  \"annotator_a_verdict\",\n  \"annotator_b_verdict\",\n  \"adjudicated_verdict\",\n  \"rationale\",\n  \"evidence_event_ids\",\n  \"test_tampering\",\n  \"capture_completeness\",\n  \"session_status\",\n  \"adjudication_status\",\n  \"adjudicator_id\",\n  \"adjudicated_at\",\n];\n\nconst args = parseArgs(process.argv.slice(2));\nconst datas