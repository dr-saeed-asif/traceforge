[],"display":{"type":"file","path":"src\\modules\\verification\\domain\\claim-types.ts","text":"/**\n * Stable claim categories produced by the claim extractor.\n *\n * These values are persisted, so renaming one requires an explicit data\n * migration and a verifier-policy version change.\n */\nexport const CLAIM_TYPES = [\n  \"FILE_CREATED\",\n  \"FILE_MODIFIED\",\n  \"STRUCTURE_CREATED\",\n  \"DEPENDENCY_RULE\",\n  \"COMMAND_SUCCEEDED\",\n  \"BUILD_PASSED\",\n  \"TEST_PASSED\",\n  \"TASK_COMPLETED\"\n] as const;\n\nexport type ClaimType = (typeof CLAIM_TYPES)[number];\n\nconst claimTypeValues = new Set<string>(CLAIM_TYPES);\n\n/** Validates untrusted extractor or database values at runtime. */\nexport function isClaimType(value: unknown): value is ClaimType {\n  return typeof value === \"string\" && claimTypeValues.has(value);\n}","lineStart":1,"lineEnd":25,"totalLines":25,"truncated":false}},"title":"src\\modules\\verification\\domain\\claim-types.ts","time":{"start":1793191155894,"end":1793191156756}},"metadata":{"openai":{"itemId":"fc_022fc43ca3f02a7a016ae1ecf2f5788191a88e91f9fd9f0502"}},"id":"prt_1828598ae001hD5TDKcTdfOYAD","sessionID":"ses_e7d7b67acffe5qdMlsdWmHlqJV","messageID":"msg_1828575b70013STsvmQyIsoUa4"},"time":1793191156757}}}}
