ing;\n86: }\n87: \n88: /** Minimal evidence pointer stored with an AgentClaim verifier decision. */\n89: export interface EvidenceReference {\n90:   readonly eventId: string;\n91:   readonly sequenceNumber: number;\n92:   readonly eventType: TraceEventType;\n93: }\n94: \n95: /** Result produced by deterministic verification; the extractor cannot set it. */\n96: export interface ClaimVerificationResult {\n97:   readonly claimIndex: number;\n98:   readonly verdict: VerificationVerdict;","metadata":{"preview":"import type { ClaimType } from \"./claim-types.js\";\nimport type { ProcessingStatus, ExecutionStatus } from \"./statuses.js\";\nimport type { TraceEventOutcome, TraceEventType } from \"./trace-event-types.js\";\nimport type { VerificationVerdict, VerdictReasonCode } from \"./verdicts.js\";\n\n/**\n * Identity shared by all records belonging to one user prompt.\n *\n * promptId is the canonical query boundary. externalSessionId may contain\n * several prompts and therefore must never be used as the unique query key.\n */\nexport interface VerificationSessionIdentity {\n  readonly promptId: string;\n  readonly externalSessionId: string;\n  readonly runId: string;\n}\n\n/** Summary state owned by the future ExecutionSession persistence model. */\nexport interface VerificationSession extends VerificationSessionIdentity {\n  readonly executionStatus: ExecutionStatus;","truncated":false,"loaded":[],"display":{"type":"file","path":"src\\modules\\verification\\domain\\contracts.ts","text":"import type { ClaimType } from \"./claim-types.js\";\nimport type { ProcessingStatus, ExecutionStatus } from \"./statuses.js\";\nimport type { TraceEventOutcome, TraceEventType } from \"./trace-event-types.js\";\nimport type { VerificationVerdict, VerdictReasonCode } from \"./verdicts.js\";\n\n/**\n * Identity shared by all records belonging to one user prompt.\n *\n * promptId is the canonical query boundary. externalSessionId may contain\n * several prompts and therefore must never 