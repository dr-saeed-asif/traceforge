HASH_ALGORITHM=sha256
LOG_LEVEL=info
TRACEFORGE_PORT=4318
TRACEFORGE_HOST=127.0.0.1
TRACEFORGE_API_TOKEN=replace-with-at-least-16-random-characters
TRACEFORGE_ARTIFACT_DIR=.traceforge/operational/artifacts
TRACEFORGE_BUFFER_DIR=.traceforge/operational/buffer
TRACEFORGE_DB_POOL_SIZE=10
TRACEFORGE_MAX_BODY_BYTES=65536
ARTIFACT_STORAGE=filesystem
ENCRYPTION_PROVIDER=local
TRACEFORGE_LOCAL_KEY_ID=local-development-key
TRACEFORGE_LOCAL_KEK_BASE64=
TRACEFORGE_LOCAL_ANCHOR_HMAC_BASE64=
DATABASE_URL=postgresql://traceforge_owner:traceforge_local_only@localhost:5432/traceforge
TEST_DATABASE_URL=postgresql://traceforge_owner:traceforge_local_only@localhost:5432/traceforge
# Never commit production credentials or local key-encryption keys.
