TRACEFORGE_DATABASE_PATH=./data/traceforge.sqlite
TRACEFORGE_API_URL=http://127.0.0.1:8080
TRACEFORGE_HOST=127.0.0.1
TRACEFORGE_PORT=8080
TRACEFORGE_API_TOKEN=replace-with-at-least-16-characters
TRACEFORGE_GENERATED_CODE_PRIVATE_KEY=generate-with-npm-run-key-generate

# Local extraction; heuristic is an explicit research baseline.
TRACEFORGE_EXTRACTOR=ollama
TRACEFORGE_LLM_ENDPOINT=http://127.0.0.1:11434/api/chat
TRACEFORGE_LLM_MODEL=qwen3.5:4b
TRACEFORGE_LLM_TIMEOUT_MS=180000
