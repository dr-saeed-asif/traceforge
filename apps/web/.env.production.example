# Publicly reachable URL of the TraceForge Phase 5 read API from the web server.
TRACEFORGE_API_URL=https://traceforge-api.example.com

# Server-only bearer credential. Never use a NEXT_PUBLIC_ prefix.
TRACEFORGE_API_TOKEN=replace-with-a-production-secret-of-at-least-16-characters

# Abort upstream reads that exceed this duration.
TRACEFORGE_API_TIMEOUT_MS=8000
