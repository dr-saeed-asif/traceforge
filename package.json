{
  "name": "traceforge-prompt-capture",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p packages/adapter-opencode/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/adapter-opencode/tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "npm run build && node --env-file-if-exists=.env dist/migrate.js",
    "api:start": "npm run build && node --env-file-if-exists=.env dist/server.js",
    "api:up": "npm run db:migrate && npm run api:start",
    "key:generate": "npm run build && node dist/generate-encryption-key.js",
    "code:decrypt": "node --env-file-if-exists=.env dist/decrypt-generated-code.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "mysql2": "^3.14.4"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.21",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
